{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",

    "declaration": true,
    "removeComments": true,
    "sourceMap": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "baseUrl": ".",                
    "paths": {
      "@/*": ["src/*"]
    },

    "ignoreDeprecations": "5.0",

    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}